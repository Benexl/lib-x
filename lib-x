    return
    ;;
  esac

  [ -z "$book_paths" ] && return

  clear
  printf "================================================================================\n"
  printf '%s' "$TXT_MISC_ADD_BOOKS_OPTIONS"
  printf "\n================================================================================\n"
  custom_args="$(ui_prompt "$TXT_MENU_MISC_ADD_BOOKS_OPTIONS_PROMPT" | tr " " '\t')"

  printf 'calibredb --library-path "%s" add %s %s\n' "$CONFIG_CALIBRE_LIBRARY_PATH" "$custom_args" "$book_paths"
  if ui_confirm "$TXT_MENU_ACTION_CONFIRM"; then
    old_ifs="$IFS"
    IFS="$(printf '\t')"
    # shellcheck disable=SC2086
    if calibredb --library-path "$CONFIG_CALIBRE_LIBRARY_PATH" add $custom_args $book_paths; then
