__menu_miscellaneous_add_books_from_folder() {
  local books_dir
  local custom_args

  case "$CONFIG_FILE_EXPLORER" in
  yazi)
    _util_terminal_exec yazi --cwd-file "$CLI_CURRENT_STATE_DIR/books_dir"
    [ -s "$CLI_CURRENT_STATE_DIR/books_dir" ] && books_dir="$(cat "$CLI_CURRENT_STATE_DIR/books_dir")"
    ;;
  fzf)
    books_dir="$(find "$HOME" -type d | ui_launcher "$TXT_MENU_MISC_ADD_BOOKS_FROM_FOLDER_PROMPT")"
    ;;
  *)
    ui_notify_error "$TXT_UNSUPPORTED_FILE_EXPLORER"
    return
    ;;
  esac

  ! [ -d "$books_dir" ] && return

  clear
  printf '\
================================================================================
%s
================================================================================
' "$TXT_MISC_ADD_BOOKS_FROM_FOLDER_OPTIONS"
  custom_args="$(ui_prompt "$TXT_MENU_MISC_ADD_BOOKS_OPTIONS_PROMPT")"

  printf 'calibredb --library-path "%s" add %s %s\n' "$CONFIG_CALIBRE_LIBRARY_PATH" "$custom_args" "$books_dir"
  if ui_confirm "$TXT_MENU_ACTION_CONFIRM"; then
    # shellcheck disable=SC2086
    if calibredb --library-path "$CONFIG_CALIBRE_LIBRARY_PATH" add $custom_args "$books_dir"; then
      __fetch_calibre_db
      __fetch_calibre_categories
    else
      ui_notify_error "$TXT_MENU_MISC_ADD_BOOKS_FROM_FOLDER_FAILED"
    fi
  fi
  if [ -n "$CMD_EXIT" ]; then
    _util_byebye
  fi
}

__menu_miscellaneous_add_books() {
  local book_paths
  local custom_args
  local old_ifs

  case "$CONFIG_FILE_EXPLORER" in
  yazi)
    _util_terminal_exec yazi --chooser-file "$CLI_CURRENT_STATE_DIR/book_paths"
