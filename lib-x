# ==============================================================================
# CALIBRE: SORT FUNCTIONS
# ==============================================================================
# shellcheck disable=SC2016
CALIBRE_SORT_JQ='
def sort_calibre_db($key):
  ($key | endswith("_asc")) as $asc
  | ($key | if $asc then rtrimstr("_asc") else . end) as $field
  | (if $field == "id" then
      sort_by(.id // 0)
    elif $field == "title" then
      sort_by(.title | ascii_downcase)
    elif $field == "author" then
      sort_by(.authors[0] // "" | ascii_downcase)
    elif $field == "series" then
      sort_by(.series // "" | ascii_downcase)
    elif $field == "series_index" then
      sort_by(.series_index // 0)
    elif $field == "rating" then
      sort_by(.rating // 0)
    elif $field == "publisher" then
      sort_by(.publisher // "" | ascii_downcase)
    elif $field == "date" or $field == "pubdate" then
      sort_by(.pubdate // "")
    elif $field == "timestamp" then
      sort_by(.timestamp // "")
    elif $field == "last_modified" then
      sort_by(.last_modified // "")
    elif $field == "size" then
      sort_by(.size // 0)
    elif $field == "formats" then
      sort_by(.formats[0] // "" | ascii_downcase)
    elif $field == "comments" then
      sort_by(.comments // "" | ascii_downcase)
    elif $field == "languages" then
      sort_by(.languages[0] // "" | ascii_downcase)
    elif $field == "tags" then
      sort_by(.tags[0] // "" | ascii_downcase)
    elif $field == "identifiers" then
      sort_by(.identifiers // {} | length)
    elif $field == "uuid" then
      sort_by(.uuid // "" | ascii_downcase)
    else
      null
    end) as $sorted
  | if $sorted == null then
      .
    elif $asc then
      $sorted
    else
      $sorted | reverse
    end;
'

CALIBRE_CONVERT_TO_ASSIGNMENTS_JQ='
def format_timestamp:
  if . != "" then
    sub("[+]00:00$"; "Z") | fromdateiso8601 | strflocaltime("%B %d, %Y at %I:%M %p")
  end;

def format_size:
  if . >= 1073741824 then
  "\((. / 1073741824 * 100 | round) / 100) GB"
  elif . >= 1048576 then
    "\((. / 1048576 * 100 | round) / 100) MB"
  elif . >= 1024 then
    "\((. / 1024 * 100 | round) / 100) KB"
  else
    "\(.) Bytes"
  end;

def escape:
  gsub("\n"; "\\n");
  
[
  "id=" + (.id // "" | @sh),
  "uuid=" + (.uuid // "" | @sh),
  "rtitle=" + (.rtitle // "" | @sh),
  "title=" + (.title // "" | @sh),
  "cover=" + (.cover // "" | @sh),
  "identifiers=" + ([.identifiers | to_entries | .[] | (.key) + " " + (.value)] | join(", ") // "" | @sh),
  "languages=" + (.languages | join(", ") // "" | @sh),
  "tags=" + (.tags | join(", ") // "" | @sh),
  "authors=" + (.authors // "" | @sh),
  "size=" + (.size // "" | format_size | @sh),
  "series=" + (.series // "" | @sh),
  "publisher=" + (.publisher // "" | @sh),
  "publish_date=" + (.pubdate // "" | if . == "0101-01-01T00:00:00+00:00" then "" end | format_timestamp | @sh),
  "series_index=" + (.series_index // "" | @sh),
  "comments=" + (.comments // "" | escape | @sh),
  "isbn=" + (.isbn // "" | @sh),
  "formats=" + (.formats[] | sub("^.+\\."; "") // "" | @sh),
  "last_modified=" + (.last_modified // "" | format_timestamp | @sh),
  "date_added=" + (.timestamp // "" | format_timestamp | @sh)
] | join(";")
'

_fetch_calibre_db_all() {
  _fetch_calibre_db | jq -r --arg sort_by "$1" "
    if \$sort_by != \"\" then
      $CALIBRE_SORT_JQ
      sort_calibre_db(\$sort_by)
      else
      .
    end
    | to_entries
    | map(
        (.key+1|tostring| if length < 2 then \"0\" + . else . end) as \$idx
        | .value.rtitle= .value.title
        | .value.title= \$idx + \" \" + .value.title
      )
    | map(.value)
    | .[]
    | $CALIBRE_CONVERT_TO_ASSIGNMENTS_JQ
  "
}

fetch_calibre_db_all() {
  _fetch_calibre_db_all "$@"
}

