__update_user_lists() {
  local user_list_paths
  local calibredb_data

  user_list_paths="\
$CLI_USER_LIST_READING
$CLI_USER_LIST_PLANNING
$CLI_USER_LIST_PAUSED
$CLI_USER_LIST_REREADING
$CLI_USER_LIST_DOCS
$CLI_USER_LIST_COMPLETED
