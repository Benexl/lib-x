__menu_main_search() {
  local query
  local sort
  local search_history
  local choice

  while true; do
    if [ "$CONFIG_SEARCH_HISTORY_ENABLE" = "true" ] && [ -s "$CLI_SEARCH_HISTORY_FILE" ]; then
      search_history="$(cat "$CLI_SEARCH_HISTORY_FILE")"
    else
      search_history=""
    fi

    if [ -n "$CMD_INPUT" ]; then
      query="$CMD_INPUT"
      unset -v CMD_INPUT
    else
      if [ -z "$search_history" ]; then
        query="$(ui_prompt "$TXT_MENU_MAIN_SEARCH_PROMPT")"
      else
        choice=$(printf "%s\n%s\n%s" "$TXT_MENU_MAIN_NEW_SEARCH" "$(printf '%s\n' "$search_history" | _util_reverse)" "$TXT_MENU_BACK" | ui_launcher "$TXT_MENU_MAIN_SEARCH_OR_HISTORY_PROMPT")
        case "$choice" in
        "$TXT_MENU_MAIN_NEW_SEARCH")
          query="$(ui_prompt "$TXT_MENU_MAIN_SEARCH_PROMPT")"
          ;;
        "$TXT_MENU_BACK" | "") break ;;
        *)
          query="$choice"
          ;;
        esac
      fi
    fi
    if [ -z "$query" ]; then
      continue
    fi

    if [ "$CONFIG_SEARCH_HISTORY_ENABLE" = "true" ]; then
      printf '%s\n' "$search_history" | awk -v query="$query" '
    $0 != "" && $0 != query && !seen[$0]++ {
      print $0
    }
    END {
      print query
    }
    ' >"$CLI_SEARCH_HISTORY_FILE"
    fi

    _state_push
    fetch_calibre_db_search "$query" "$CONFIG_SORT_BY" >"$STATE_CURRENT_BOOKS"
    menu_book_list_explorer
    if [ -n "$CMD_EXIT" ]; then
      _util_byebye
    fi
  done
}

