__menu_book_actions_read() {
  local book_path
  local reader

  if [ "$CONFIG_RECENT_BOOKS_UPDATE" = "true" ]; then
    manage_user_list_add "$CLI_USER_LIST_RECENT" "$CONFIG_RECENT_BOOKS_LIMIT"
  fi

  book_path="$(cat "$STATE_CURRENT_BOOK" | jq -r '.formats[0]')"

  if [ -n "$CONFIG_READER" ]; then
    reader="$(
      printf '%s' "$CONFIG_READER" |
        awk -F: -v RS=, -v book_path="$book_path" 'tolower(book_path) ~ "\\." $1 "$" {print $2}'
    )"
  fi

  if [ -z "$reader" ]; then
    if [ "$CONFIG_READING_PROCESS_DISOWN" = "true" ]; then
      (_util_open "$book_path" >/dev/null 2>&1 &)
    else
      _util_open "$book_path"
    fi
  else
    if [ "$CONFIG_READING_PROCESS_DISOWN" = "true" ]; then
      ("$reader" "$book_path" >/dev/null 2>&1 &)
    else
      $reader "$book_path"
    fi
  fi
}

