_app_cmd_line_parser() {
  local shift_count
  while [ $# -gt 0 ]; do
    shift_count=1
    case "$1" in
    -h | --help) _app_usage ;;
    -v | --version) printf '%s v%s GPL V3 Copyright © 2024 %s\n' "$CLI_NAME" "$CLI_VERSION" "$CLI_AUTHOR" && exit 0 ;;
    -U | --update) _app_update_check || printf '%s\n' "$TXT_UPDATE_NOT_FOUND" && exit 1 ;;
    -e | --edit-config) _app_edit_config ;;
    -E | --generate-desktop-entry) _app_generate_desktop_entry ;;
    -ce | --cmd-exit) CMD_EXIT=true ;;
    -bs | --book-skip) CMD_BOOK_RESULTS_SKIP=true ;;
    -be | --book-exit) CMD_BOOK_EXIT=true ;;
    -d | --disown-reading-process) CONFIG_READING_PROCESS_DISOWN="true" ;;
    -D | --no-disown-reading-process) CONFIG_READING_PROCESS_DISOWN="false" ;;
    --config-write) _print_config >"$CLI_CONFIG_FILE" && exit 0 ;;
    --preview) CONFIG_PREVIEW_ENABLE=true ;;
    --no-preview) CONFIG_PREVIEW_ENABLE=false ;;
    --preview-images) CONFIG_PREVIEW_IMAGES_ENABLE=true ;;
    --no-preview-images) CONFIG_PREVIEW_IMAGES_ENABLE=false ;;
    --private) CONFIG_RECENT_BOOKS_UPDATE="false" ;;
    -l | --launcher)
      [ -n "$2" ] || _app_usage 1
      CONFIG_LAUNCHER="$2"
      shift_count=2
      ;;
    --rofi-theme-main | --rofi-theme)
      [ -n "$2" ] || _app_usage 1
      CONFIG_ROFI_THEME_MAIN="$2"
      shift_count=2
      ;;
    --rofi-theme-preview)
      [ -n "$2" ] || _app_usage 1
      CONFIG_ROFI_THEME_PREVIEW="$2"
      shift_count=2
      ;;
    --rofi-theme-prompt)
      [ -n "$2" ] || _app_usage 1
      CONFIG_ROFI_THEME_PROMPT="$2"
      shift_count=2
      ;;
    --rofi-theme-confirm)
      [ -n "$2" ] || _app_usage 1
      CONFIG_ROFI_THEME_CONFIRM="$2"
      shift_count=2
      ;;
    -x | --extension)
      [ -n "$2" ] || _app_usage 1
      if [ "${2#/}" != "$2" ]; then
        . "$2"
      else
        . "$CLI_EXTENSIONS_DIR/$2"
      fi
      shift_count=2
      ;;
    -xargs | --extension-arguments)
      shift
      # shellcheck disable=SC2034
      readonly CLI_EXTENSION_CMDLINE_ARGS="$*"
      return
      ;;
    --reading-list) CMD_MAIN_ACTION="$TXT_MENU_MAIN_READING" ;;
    --recent) CMD_MAIN_ACTION="$TXT_MENU_MAIN_RECENT" ;;
    --paused) CMD_MAIN_ACTION="$TXT_MENU_MAIN_PAUSED" ;;
    --rereading) CMD_MAIN_ACTION="$TXT_MENU_MAIN_REREADING" ;;
    --planning) CMD_MAIN_ACTION="$TXT_MENU_MAIN_PLANNING" ;;
    --completed) CMD_MAIN_ACTION="$TXT_MENU_MAIN_COMPLETED" ;;
    --docs) CMD_MAIN_ACTION="$TXT_MENU_MAIN_DOCS" ;;
    --dropped) CMD_MAIN_ACTION="$TXT_MENU_MAIN_DROPPED" ;;
    --all) CMD_MAIN_ACTION="$TXT_MENU_MAIN_ALL" ;;
    --random) CMD_MAIN_ACTION="$TXT_MENU_MAIN_RANDOM" ;;
    --misc | --miscellaneous) CMD_MAIN_ACTION="$TXT_MENU_MAIN_MISC" ;;
    --read) CMD_BOOK_ACTION="$TXT_MENU_BOOK_ACTIONS_READ" ;;
    --edit-metadata) CMD_BOOK_ACTION="$TXT_MENU_BOOK_ACTIONS_EDIT_METADATA" ;;
    --remove-book) CMD_BOOK_ACTION="$TXT_MENU_BOOK_ACTIONS_REMOVE_BOOK" ;;
    --viewer) CMD_BOOK_ACTION="$TXT_MENU_BOOK_ACTIONS_VIEWER" ;;
    --convert) CMD_BOOK_ACTION="$TXT_MENU_BOOK_ACTIONS_CONVERT" ;;
    --edit-book) CMD_BOOK_ACTION="$TXT_MENU_BOOK_ACTIONS_EDIT" ;;
    --polish) CMD_BOOK_ACTION="$TXT_MENU_BOOK_ACTIONS_POLISH" ;;
    --show-metadata) CMD_BOOK_ACTION="$TXT_MENU_BOOK_ACTIONS_METADATA" ;;
    -s | --search)
      if [ -z "$2" ]; then
        CMD_INPUT="$(ui_prompt "$TXT_MENU_MAIN_SEARCH_PROMPT")"
        [ -n "$CMD_INPUT" ] || _app_usage 1
      else
        CMD_INPUT="$2"
        shift_count=2
      fi
      CMD_MAIN_ACTION="$TXT_MENU_MAIN_SEARCH"
      ;;
    --search-title)
      if [ -z "$2" ]; then
        CMD_INPUT="$(ui_prompt "$TXT_MENU_MAIN_SEARCH_TITLE_PROMPT")"
        [ -n "$CMD_INPUT" ] || _app_usage 1
      else
        CMD_INPUT="$2"
        shift_count=2
      fi
      CMD_MAIN_ACTION="$TXT_MENU_MAIN_SEARCH_TITLE"
      ;;
    -S | --sort-by)
      if [ -z "$2" ]; then
        CONFIG_SORT_BY="$(ui_prompt "$TXT_SORT_BY")"
        [ -n "$CONFIG_SORT_BY" ] || _app_usage 1
      else
        CONFIG_SORT_BY="$2"
        shift_count=2
      fi
      ;;
    -r | --no-of-random-books)
      if [ -z "$2" ]; then
        CONFIG_RANDOM_BOOKS_LIMIT="$(ui_prompt "Number of random books")"
        [ -n "$CONFIG_RANDOM_BOOKS_LIMIT" ] || _app_usage 1
      else
        CONFIG_RANDOM_BOOKS_LIMIT="$2"
        shift_count=2
      fi
      CMD_MAIN_ACTION="${CMD_MAIN_ACTION:-$TXT_MENU_MAIN_RANDOM}"
      ;;
    completions)
      [ -n "$2" ] || _app_usage_completions 1
      case "$2" in
      -f | --fish) _app_completions_fish ;;
      -b | --bash) printf '%s\n' "Contribute to $CLI_NAME by writing bash completions" && exit 1 ;;
      -z | --zsh) printf '%s\n' "Contribute to $CLI_NAME by writing zsh completions" && exit 1 ;;
      -h | --help) _app_usage_completions ;;
      *) _app_usage_completions 1 ;;
      esac
      shift_count=2
      ;;
    *) _app_usage 1 ;;
    esac
    shift $shift_count
  done
}

# ==============================================================================
# APP
# ==============================================================================
main() {
  trap _app_runtime_clean_up EXIT INT TERM
  _load_config
  _app_cmd_line_parser "$@"
  _app_auto_update
  _app_core_dep_ch
  menu_main
}

main "$@"

