_manage_user_list_add() {
  local user_list_path
  local action
  local limit
  local user_list

  user_list_path="$1"
  action="$2"
  limit="${3}"

  if [ -s "$user_list_path" ]; then
    user_list="$(cat "$user_list_path")"
  else
    user_list="[]"
  fi

  printf '%s' "$user_list" | jq --argjson book "$(cat "$STATE_CURRENT_BOOK")" --arg limit "$limit" '
    map(select(.id != $book.id))
    | . + [$book]
    | if ($limit | type) == "number" and (. | length) > $limit then
        .[((. | length) - $limit):]
      end
    ' >"$user_list_path"
}

manage_user_list_add() {
  _manage_user_list_add "$@"
}

_manage_user_list_remove() {
  local user_list_paths

  user_list_paths="\
$CLI_USER_LIST_READING
$CLI_USER_LIST_PLANNING
$CLI_USER_LIST_PAUSED
$CLI_USER_LIST_REREADING
$CLI_USER_LIST_DOCS
$CLI_USER_LIST_COMPLETED
$CLI_USER_LIST_DROPPED"

  printf '%s' "$user_list_paths" | while IFS= read -r user_list_path; do

    if ! [ -s "$user_list_path" ]; then
      continue
    fi

    user_list="$(cat "$user_list_path")"
    printf '%s' "$user_list" | jq --argjson book "$(cat "$STATE_CURRENT_BOOK")" '
    map(select(.id != $book.id))
    ' >"$user_list_path"
  done
}

manage_user_list_remove() {
  _manage_user_list_remove
}

_manage_user_list() {
  local action

  action="$1"

  case "$action" in
  "$CLI_USER_LIST_READING" | "$CLI_USER_LIST_PLANNING" | "$CLI_USER_LIST_PAUSED" | "$CLI_USER_LIST_REREADING" | "$CLI_USER_LIST_DOCS" | "$CLI_USER_LIST_COMPLETED" | "$CLI_USER_LIST_DROPPED")
    manage_user_list_remove
    manage_user_list_add "$action"
    ;;
  remove)
    manage_user_list_remove
    ;;
  *)
    ui_notify_error "$TXT_ERROR_INVALID_ACTION: $action"
    ;;
  esac
}

manage_user_list() {
  _manage_user_list "$@"
}

