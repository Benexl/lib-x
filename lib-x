  rm -rf "$current_state_dir"
}

_state_init() {
  STATE_CALIBRE_LIBRARY_NAME="$(basename "$CONFIG_CALIBRE_LIBRARY_PATH" | sed 's/ /_/g')"

  readonly CLI_USER_LISTS="$CLI_CONFIG_DIR/$STATE_CALIBRE_LIBRARY_NAME/my-lists"
  readonly CLI_USER_LIST_RECENT="$CLI_CONFIG_DIR/recent.json"

  readonly CLI_USER_LIST_READING="$CLI_USER_LISTS/reading.json"
  readonly CLI_USER_LIST_PAUSED="$CLI_USER_LISTS/paused.json"
  readonly CLI_USER_LIST_PLANNING="$CLI_USER_LISTS/planning.json"
  readonly CLI_USER_LIST_REREADING="$CLI_USER_LISTS/re-reading.json"
  readonly CLI_USER_LIST_COMPLETED="$CLI_USER_LISTS/completed.json"
  readonly CLI_USER_LIST_DROPPED="$CLI_USER_LISTS/dropped.json"
  readonly CLI_USER_LIST_DOCS="$CLI_USER_LISTS/docs.json"

  readonly CLI_LIBRARY_CACHE_DIR="$CLI_CACHE_DIR/$STATE_CALIBRE_LIBRARY_NAME"
  readonly CLI_STATE_DIR="$CLI_LIBRARY_CACHE_DIR/state"
  readonly CLI_CURRENT_STATE_DIR="$CLI_STATE_DIR/${CLI_START_TIME}-$$"

  readonly CLI_SEARCH_HISTORY_FILE="$CLI_LIBRARY_CACHE_DIR/search-history.txt"
  readonly CLI_PREVIEW_SCRIPTS_DIR="$CLI_LIBRARY_CACHE_DIR/previews"
  readonly CLI_FZF_PREVIEW_SCRIPT="$CLI_PREVIEW_SCRIPTS_DIR/fzf-preview.sh"

  readonly CALIBRE_LIBRARY_CACHED_TIMESTAMP_FILE="$CLI_LIBRARY_CACHE_DIR/.calibre_library_timestamp"
  readonly CALIBRE_DB_JSON_FILE="$CLI_LIBRARY_CACHE_DIR/calibre_db.json"
  readonly CALIBRE_CATEGORIES_CSV_FILE="$CLI_LIBRARY_CACHE_DIR/calibre_categories.csv"

  mkdir -p \
    "$CLI_USER_LISTS" \
    "$CLI_CURRENT_STATE_DIR" \
    "$CLI_PREVIEW_SCRIPTS_DIR"

  STATE_CURRENT=0

  STATE_CURRENT_CATEGORY=""

  STATE_CURRENT_BOOKS=""

  STATE_CURRENT_BOOK=""
  STATE_CURRENT_BOOK_TITLE=""
}

_state_push() {
  local current_state_dir

  STATE_CURRENT="$((STATE_CURRENT + 1))"
  current_state_dir="$CLI_CURRENT_STATE_DIR/$STATE_CURRENT"
  mkdir -p "$current_state_dir"

  STATE_CURRENT_CATEGORY="$current_state_dir/category.txt"
  STATE_CURRENT_BOOKS="$current_state_dir/books.env"
  STATE_CURRENT_BOOK_TITLE="$current_state_dir/book-title.txt"
  STATE_CURRENT_BOOK="$current_state_dir/book.json"
}

_state_pop() {
  local current_state_dir
  local pop_count
  local i
  i=0
  pop_count="${1:-1}"

  [ "$pop_count" -le 0 ] && return

  while [ "$i" -lt "$pop_count" ]; do
    __state_clean_prev
    STATE_CURRENT="$((STATE_CURRENT - 1))"
    i=$((i + 1))
  done

  [ "$((STATE_CURRENT))" -lt 1 ] && return

  current_state_dir="$CLI_CURRENT_STATE_DIR/$STATE_CURRENT"
  ! [ -d "$current_state_dir" ] && ui_notify_critical "$TXT_STATE_MALFORMED_CURRENT"

  STATE_CURRENT_CATEGORY="$current_state_dir/category.txt"
  STATE_CURRENT_BOOKS="$current_state_dir/books.env"
  STATE_CURRENT_BOOK_TITLE="$current_state_dir/book-title.txt"
  STATE_CURRENT_BOOK="$current_state_dir/book.json"
}

