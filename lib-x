      "$TXT_MENU_BACK" | "") break ;;
      esac
    fi

    _state_push
    printf 'identifiers,%s' "$query" >"$STATE_CURRENT_CATEGORY"
    fetch_calibre_db_search_identifier "$query" "$CONFIG_SORT_BY" >"$STATE_CURRENT_BOOKS"
    menu_book_list_explorer
    if [ -n "$CMD_EXIT" ]; then
      _util_byebye
    fi
  done
