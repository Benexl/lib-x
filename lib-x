__preview_fzf_create_shared_script() {
  if ! [ -s "$CLI_FZF_PREVIEW_SCRIPT" ]; then
    cat <<'EOF' >"$CLI_FZF_PREVIEW_SCRIPT"
#!/usr/bin/env sh
# ==============================================================================
# Shared script for fzf previews
# ==============================================================================

draw_divider() {
  ll=1
  while [ $ll -le $FZF_PREVIEW_COLUMNS ];do printf "${THEME_FZF_PREVIEW_DIVIDER}─${THEME_RESET}" ;ll=$(( ll + 1 ));done;
  echo
}

preview_kv() {
  key=$1
  value=$2

  if [ -n "$value" ]; then
    printf "${THEME_FZF_PREVIEW_KEY}${THEME_BOLD}%s:${THEME_RESET} ${THEME_FZF_PREVIEW_VALUE}%s${THEME_RESET}\n" "$key" "$value"
  fi
}

preview_img() {
  file=$1

  dim=${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}
  if [ "$dim" = "x" ]; then
    dim=$(stty size </dev/tty | awk "{print \$2 \"x\" \$1}")
  fi
  if ! [ "$CONFIG_PREVIEW_IMAGES_RENDERER" = "icat" ] && [ -z "$KITTY_WINDOW_ID" ] && [ "$((FZF_PREVIEW_TOP + FZF_PREVIEW_LINES))" -eq "$(stty size </dev/tty | awk "{print \$1}")" ]; then
    dim=${FZF_PREVIEW_COLUMNS}x$((FZF_PREVIEW_LINES - 1))
  fi

  if [ "$CONFIG_PREVIEW_IMAGES_RENDERER" = "icat" ] && [ -z "$GHOSTTY_BIN_DIR" ]; then
    if command -v kitten >/dev/null 2>&1; then
      kitten icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no --place="$dim@0x0" "$file" | sed "\$d" | sed "$(printf "\$s/\$/\033[m/")"
    elif command -v icat >/dev/null 2>&1; then
      icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no --place="$dim@0x0" "$file" | sed "\$d" | sed "$(printf "\$s/\$/\033[m/")"
    else
      kitty icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no --place="$dim@0x0" "$file" | sed "\$d" | sed "$(printf "\$s/\$/\033[m/")"
    fi

  elif [ -n "$GHOSTTY_BIN_DIR" ]; then
    if command -v kitten >/dev/null 2>&1; then
      kitten icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no --place="$dim@0x0" "$file" | sed "\$d" | sed "$(printf "\$s/\$/\033[m/")"
    elif command -v icat >/dev/null 2>&1; then
      icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no --place="$dim@0x0" "$file" | sed "\$d" | sed "$(printf "\$s/\$/\033[m/")"
    else
      chafa -s "$dim" "$file"
    fi
  elif command -v chafa >/dev/null 2>&1; then
    case "$CLI_PLATFORM" in
    android) chafa -s "$dim" "$file" ;;
    windows) chafa -f sixels --colors=full --polite=on --animate=off -s "$dim" "$file" ;;
    *) chafa -s "$dim" "$file" ;;
    esac
    echo

  elif command -v imgcat >/dev/null; then
    imgcat -W "${dim%%x*}" -H "${dim##*x}" "$file"

  else
    printf "%s" "$TXT_PREVIEW_INSTALL_VIEWER"
  fi
}

# ==============================================================================
# here is where the magic starts
# ==============================================================================
if [ "$CONFIG_PREVIEW_IMAGES_ENABLE" = 'true' ];then
  if [ -s "$cover" ];then
    preview_img "$cover"
  fi
fi

draw_divider

printf "${THEME_FZF_PREVIEW_TITLE}${THEME_BOLD}%s${THEME_RESET}\n" "$rtitle"

draw_divider

preview_kv "Authors" "$authors"
preview_kv "Publisher" "$publisher"
preview_kv "Series" "$series"

if [ -n "$authors" ] || [ -n "$publisher" ] || [ -n "$series" ]; then
  draw_divider
fi

preview_kv "Tags" "$tags"
preview_kv "Formats" "$formats"
preview_kv "Languages" "$languages"

if [ -n "$tags" ] || [ -n "$formats" ] || [ -n "$languages" ]; then
draw_divider
fi

preview_kv "Identifiers" "$identifiers"
preview_kv "Isbn" "$isbn"

if [ -n "$identifiers" ] || [ -n "$isbn" ]; then
  draw_divider
fi

preview_kv "Size" "$size"
preview_kv "Publish Date" "$publish_date"
preview_kv "Last Modified" "$last_modified"
preview_kv "Date Added" "$date_added"

if [ -n "$size" ] || [ -n "$publish_date" ] || [ -n "$last_modified" ] || [ -n "$last_modified" ]; then
  draw_divider
fi

if [ -n "$comments" ]; then
  printf "${THEME_FZF_PREVIEW_VALUE}%s${THEME_RESET}\n" "$comments"
fi
EOF
  fi
}

_preview_fzf() {
  local id
  local title

  __preview_fzf_create_shared_script </dev/null
  while IFS= read -r line; do
    case "$line" in
    id*)
      eval "$line"
      if [ "$CONFIG_PREVIEW_ENABLE" = "true" ]; then
        preview_script_path="$CLI_PREVIEW_SCRIPTS_DIR/$id.env"

        printf '%s|%s\n' "$preview_script_path" "$title"

        if ! [ -s "$preview_script_path" ]; then
          printf '%s\n' "$line" >"$preview_script_path"
        fi
      else
        printf '%s\n' "$title"
      fi
      ;;
    *)
      if [ "$CONFIG_PREVIEW_ENABLE" = "true" ]; then
        printf '|%s\n' "$line"
      else
        printf '%s\n' "$line"
      fi
      ;;
    esac
  done
}

preview_fzf() {
  _preview_fzf "$@"
}

_preview_rofi() {
  local title
  local cover

  while IFS= read -r line; do
    case "$line" in
    id*)
      eval "$line"
      if [ "$CONFIG_PREVIEW_ENABLE" = "true" ]; then
        printf '%s\0icon\x1f%s\n' "$title" "$cover"
      else
        printf '%s\n' "$title"
      fi
      ;;
    *)
      printf '%s\n' "$line"
      ;;
    esac
  done
}

preview_rofi() {
  _preview_rofi "$@"
}

_preview() {
  case "$CONFIG_LAUNCHER" in
  fzf) preview_fzf "$@" ;;
  rofi) preview_rofi "$@" ;;
  *) cat ;;
  esac
}

preview() {
  _preview "$@"
}

