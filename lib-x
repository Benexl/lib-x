_fetch_calibre_db_search() {
  _fetch_calibre_db | jq -r --arg query "$1" --arg sort_by "$2" "
    map(select(
      (.title // \"\" | test(\$query; \"i\")) or
      (.authors // \"\" | test(\$query; \"i\")) or
      any(.tags[]?; test(\$query; \"i\")) or
      (.series // \"\" | test(\$query; \"i\")) or
      (.comments // \"\" | test(\$query; \"i\")) or
      (.publisher // \"\" | test(\$query; \"i\"))
    ))
    | if \$sort_by != \"\" then
        $CALIBRE_SORT_JQ
        sort_calibre_db(\$sort_by)
       else
        .
      end
      | to_entries
      | map(
          (.key+1|tostring| if length < 2 then \"0\" + . else . end) as \$idx
          | .value.rtitle= .value.title
          | .value.title= \$idx + \" \" + .value.title
        )
      | map(.value)
      | .[]
      | $CALIBRE_CONVERT_TO_ASSIGNMENTS_JQ
  "
}

