__menu_book_actions_edit_metadata() {
  local fields
  local field
  local book_id
  local val

  fields="\
authors
author_sort
comments
cover
id
identifiers
languages
pubdate
publisher
rating
series
series_index
size
sort
tags
timestamp
title
title_sort"

  while true; do
    field="$(printf '%s\n%s' "$fields" "$TXT_MENU_BACK" | ui_launcher "$TXT_MENU_BOOK_ACTIONS_PROMPT_FIELD")"

    case "$field" in
    "$TXT_MENU_BACK" | "") break ;;
    *)
      book_id="$(cat "$STATE_CURRENT_BOOK" | jq -r '.id')"
      calibredb --library-path "$CONFIG_CALIBRE_LIBRARY_PATH" show_metadata "$book_id"
      val="$(ui_prompt "$TXT_MENU_BOOK_ACTIONS_PROMPT_NEW_VAL $field")"

      if [ -n "$val" ] && ui_confirm "$TXT_MENU_BOOK_ACTIONS_CONFIRM_UPDATE $field to $val?"; then
        calibredb --library-path "$CONFIG_CALIBRE_LIBRARY_PATH" set_metadata "$book_id" --field "$field:$val"
        calibredb --library-path "$CONFIG_CALIBRE_LIBRARY_PATH" embed_metadata "$book_id"
        calibredb --library-path "$CONFIG_CALIBRE_LIBRARY_PATH" backup_metadata
        __fetch_calibre_db
        __fetch_calibre_categories
      fi
      ;;
    esac
  done

}

__menu_book_actions_pick_format() {
  local formats
  local format

  formats="$(cat "$STATE_CURRENT_BOOK" | jq -r '.formats[]')"

  if [ -z "$formats" ]; then
    ui_notify_warning "$TXT_MENU_BOOK_ACTIONS_NO_FORMATS"
    return 1
  fi

  if [ "$(printf '%s\n' "$formats" | wc -l)" -eq 1 ]; then
    printf '%s' "$formats"
    return 0
  fi

  format="$(printf '%s\n%s' "$formats" "$TXT_MENU_BACK" | ui_launcher "$TXT_MENU_BOOK_ACTIONS_FORMAT_PROMPT")"

  case "$format" in
  "$TXT_MENU_BACK" | "") return 1 ;;
  *) printf '%s' "$format" ;;
  esac
}

