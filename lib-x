__menu_book_actions_polish() {
  local book_path
  local options
  local action

  book_path="$(__menu_book_actions_pick_format)" || return 1

  if ! _dep_ch ebook-polish; then
    ui_notify_error "$TXT_DEP_MISSING_EBOOK_POLISH"
    return 1
  fi

  options="\
--add-soft-hyphens: Add soft hyphens to all words in the book
--compress-images: Losslessly compress images in the book to reduce the filesize
--download-external-resources: Download external resources (images, stylesheets) and embed them in the book
--embed-fonts: Embed all fonts referenced in the document that are not already embedded
--jacket: Insert a book jacket page with all the book metadata
--remove-jacket: Remove a previously inserted book jacket page
--remove-soft-hyphens: Remove soft hyphens from all text in the book
--remove-unused-css: Remove all unused CSS rules from stylesheets and style tags
--smarten-punctuation: Convert plain text dashes, ellipsis, quotes, multiple hyphens, etc. into their typographically correct equivalents
--subset-fonts: Subset embedded fonts to only the glyphs used
--upgrade-book: Upgrade the internal structures of the book (e.g. EPUB 2 to EPUB 3)"

  action="$(printf '%s\n%s' "$options" "$TXT_MENU_BACK" | ui_launcher "$TXT_MENU_BOOK_ACTIONS_POLISH_PROMPT")"

  case "$action" in
  "$TXT_MENU_BACK" | "") return 1 ;;
  *) action="${action%%:*}" ;;
  esac

  if ui_confirm "$TXT_MENU_BOOK_ACTIONS_POLISH_CONFIRM $action?"; then
    if ebook-polish "$action" "$book_path"; then
      ui_notify "$TXT_MENU_BOOK_ACTIONS_POLISHED"
